#!/usr/bin/env bash
set -uo pipefail

STATUS_TIMEOUT=${NORDLAYER_STATUS_TIMEOUT:-5}
CONTAINER=${NORDLAYER_CONTAINER:-nordlayer-vpn}

esc() {
  local s
  s=$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/&/\&amp;/g' \
    -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
  printf '%s' "${s//$'\n'/\\n}"
}

emit() {
  printf '{"text":"%s","alt":"%s","class":"%s","tooltip":"%s"}\n' \
    "$(esc "$1")" "$2" "$2" "$(esc "$3")"
  exit 0
}

join_lines() {
  local out="" line
  for line in "$@"; do
    [[ -n $line ]] || continue
    if [[ -z $out ]]; then
      out=$line
    else
      out+=$'\n'$line
    fi
  done
  printf '%s' "$out"
}

field() {
  printf '%s\n' "$clean" | sed -n "s/^$1:[[:space:]]*//p" | head -n1 | sed 's/[[:space:]]*$//'
}

command -v docker >/dev/null 2>&1 || exit 0

if state=$(timeout "$STATUS_TIMEOUT" docker container ls -a \
  --filter "name=^$CONTAINER\$" --format '{{.State}}' 2>/dev/null); then
  [[ -n $state ]] || exit 0
fi

[[ -e /sys/class/net/nlx0 ]] && emit "host vpn" host-vpn \
  "$(join_lines "NordLayer is connected on the host, calls will suffer" "Run: nordlayer disconnect")"

case "$state" in
  running) ;;
  exited | created)
    emit "off" disconnected "$(join_lines "VPN container is stopped" "Run: vpn on")"
    ;;
  "")
    emit "n/a" error "docker is not responding"
    ;;
  *)
    emit "$state" error "VPN container is $state"
    ;;
esac

raw=$(timeout "$STATUS_TIMEOUT" docker exec -u nobody:nordlayer "$CONTAINER" nordlayer status 2>&1)
plain=$(printf '%s\n' "$raw" \
  | sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\r/\n/g' -e 's/\[[-\\|/]\][^.]*\.\.\.//g')
clean=$(printf '%s\n' "$plain" | sed 's/.*\(Login:\)/\1/')

login=$(field 'Login')
if [[ -z $login ]]; then
  detail=$(printf '%s\n' "$plain" | grep -v '^[[:space:]]*$' | head -n3)
  emit "n/a" error "$(join_lines "nordlayer status unavailable" "$detail")"
fi

account=""
if [[ $login =~ \[(.+)\] ]]; then
  account=${BASH_REMATCH[1]}
fi
account_line=""
if [[ -n $account ]]; then
  user=${account%% *}
  if [[ $account == *" "* ]]; then
    account_line="Account: $user [${account#* }]"
  else
    account_line="Account: $user"
  fi
fi

case "$login" in
  "Not logged in"*)
    emit "logged out" logged-out \
      "$(join_lines "Not logged in to NordLayer" "Run: ./nl login in ~/dev/nordlayer-docker")"
    ;;
esac

case "$(field 'VPN')" in
  Connected*)
    gateway=$(field 'Gateway')
    server=$(field 'Server address')
    protocol=$(field 'Protocol')
    server_line=$server
    [[ -n $protocol ]] && server_line="${server_line:+$server_line }($protocol)"
    emit "${gateway:-connected}" connected \
      "$(join_lines "${gateway:-Connected}" "$server_line" "$account_line")"
    ;;
  Connecting*)
    emit "connecting…" connecting \
      "$(join_lines "Connecting to NordLayer…" "$account_line")"
    ;;
  Disconnecting*)
    emit "disconnecting…" disconnecting \
      "$(join_lines "Disconnecting from NordLayer…" "$account_line")"
    ;;
  *)
    emit "off" disconnected \
      "$(join_lines "VPN not connected, the container retries every 20 s" "$account_line")"
    ;;
esac
